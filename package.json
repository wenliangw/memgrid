{
  "name": "memgrid",
  "version": "0.6.0",
  "description": "Project-level semantic memory system for AI coding agents. Replaces full-codebase context loading with a self-evolving knowledge-mesh.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memgrid": "dist/serve/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "node dist/serve/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "keywords": [
    "ai",
    "memory",
    "claude-code",
    "agent",
    "coding-agent",
    "knowledge-graph",
    "semantic-memory",
    "rag",
    "context"
  ],
  "author": "wenliangw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenliangw/memgrid.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "commander": "^13",
    "minisearch": "^7",
    "ts-morph": "^28"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.5",
    "typescript": "^6",
    "vitest": "^4"
  }
}
